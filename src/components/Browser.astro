---
import Card from './Card.astro';
import { categories, entryHref, byId, href, type Entry } from '../lib/data';
import {statSorts,sortedBrowseGroups} from '../lib/browse';
import TierBadge from './TierBadge.astro';
import PowerBadge from './PowerBadge.astro';
import {powerRanks,powerRankInfo} from '../lib/power';
interface Props { items: Entry[]; category?: string; rewardFilter?: boolean; collection?: boolean; }
const {items, category = '', rewardFilter = false, collection = false} = Astro.props;
const storyOrder = category==='missions'||category==='campaigns';
const ranked = items.some(e=>!!e.power);
const defaultSort = storyOrder?'campaign-order':ranked?'power-high':'name';
const groups = sortedBrowseGroups(items.filter(e => !e.spoiler),defaultSort,true,byId);
const initial = groups.slice(0, 48);
const hasFamilies = items.some(e=>!!e.family);
const availableTiers = ['Base','P','SP','HSP'].filter(tier=>items.some(e=>e.tier===tier));
const availableStatSorts = statSorts.filter(option=>items.some(e=>e.stats?.[option.stat]!==undefined));
const rarities = [...new Set(items.map(e => e.rarity).filter(Boolean))];
const types = [...new Set(items.map(e => e.type).filter(Boolean))].sort();
const factions = [...new Set(items.map(e => e.faction).filter(Boolean))].sort();
---
<div class="database-browser" data-category={category} data-ids={category ? undefined : JSON.stringify(items.map(e=>e.id))} data-collection={collection ? 'true' : 'false'}>
<div class="filters">
  <div class="field wide"><label for="db-query">SEARCH NAME, ABILITY, PACK OR SOURCE</label><input id="db-query" type="search" placeholder="Search the database…" autocomplete="off" /></div>
  {!category && <div class="field"><label for="db-category">CATEGORY</label><select id="db-category"><option value="">All categories</option>{Object.entries(categories).map(([key,c]) => <option value={key}>{c.label}</option>)}<option value="guides">Guides</option><option value="factions">Factions</option></select></div>}
  <div class="field"><label for="db-rarity">RARITY</label><select id="db-rarity"><option value="">All rarities</option>{['Common','Rare','Epic','Legendary'].filter(r => rarities.includes(r)).map(r => <option>{r}</option>)}</select></div>
  {availableTiers.length>0 && <div class="field"><label for="db-tier">CARD TIER</label><select id="db-tier"><option value="">All tiers</option>{availableTiers.map(tier=><option value={tier}>{tier==='Base'?'Base':tier==='P'?'P · Prototype':tier==='SP'?'SP · Secret Prototype':'HSP · Hidden Secret Prototype'}</option>)}</select></div>}
  {ranked && <div class="field"><label for="db-power">POWER RANK</label><select id="db-power"><option value="">All ranks</option>{powerRanks.map(rank=><option value={rank}>{rank} · {powerRankInfo[rank].label}</option>)}</select></div>}
  <div class="field"><label for="db-type">TYPE</label><select id="db-type"><option value="">All types</option>{types.map(t => <option>{t}</option>)}</select></div>
  {factions.length > 0 && <div class="field"><label for="db-faction">FACTION</label><select id="db-faction"><option value="">All factions</option>{factions.map(f => <option>{f}</option>)}</select></div>}
  {rewardFilter && <><div class="field"><label for="db-reward-type">REWARD CATEGORY</label><select id="db-reward-type"><option value="">Any reward</option><option value="warmachines">War Machines</option><option value="pilots">Pilots</option><option value="items">Equipment</option><option value="currency">Currency</option></select></div><div class="field"><label for="db-reward-rarity">REWARD RARITY</label><select id="db-reward-rarity"><option value="">Any rarity</option>{['Common','Rare','Epic','Legendary'].map(r => <option>{r}</option>)}</select></div></>}
  <div class="field"><label for="db-sort">SORT</label><select id="db-sort">{storyOrder&&<option value="campaign-order" selected>Story order: campaign & chapter</option>}{ranked&&<><option value="power-high" selected>Power: best first</option><option value="power-low">Power: weakest first</option></>}<option value="name">Name A–Z</option><option value="name-desc">Name Z–A</option>{availableTiers.length>0 && <><option value="tier-high">Tier: HSP → SP → P → Base</option><option value="tier-low">Tier: Base → P → SP → HSP</option></>}<option value="rarity">Rarity: highest</option>{availableStatSorts.map(option=><option value={option.value}>{option.label}</option>)}</select></div>
</div>
{availableTiers.length>0 && <div class="browse-tier-help"><div class="browse-tier-legend" aria-label="Card tiers">{availableTiers.map(tier=><TierBadge tier={tier} />)}</div><p>Card tier (Base → HSP) is the version of a card. <b>Power rank</b> (S → D) is how good it is in combat. <a class="text-link" href={href('tier-list/')}>Open the tier list →</a></p>{ranked&&<div class="browse-power-legend" aria-label="Power ranks">{powerRanks.map(rank=><span><PowerBadge power={{rank,score:0,position:0,of:0}} />{powerRankInfo[rank].label}</span>)}</div>}</div>}
<div class="results-meta"><span id="result-count" role="status" aria-live="polite">{groups.length} results · variants grouped</span><div class="browse-toggles">{hasFamilies && <label class="spoiler-toggle"><input type="checkbox" id="db-group" checked /> Group variants</label>}<label class="spoiler-toggle"><input type="checkbox" id="db-spoilers" /> Reveal spoilers</label></div></div>
<div id="db-gallery" class="gallery">{initial.map(group => <Card entry={group[0]} variants={group[0].family ? group : []} />)}</div>
<div id="db-empty" class="empty-state" hidden>No results. Try a shorter name or clear a filter.</div>
<nav class="pagination" aria-label="Result pages"><button id="db-prev" type="button" disabled>← Previous</button><span id="db-page">Page 1</span><button id="db-next" type="button">Next →</button></nav>
<noscript><p class="notice">Enable JavaScript for search, filters and interactive tools. Every database page is also linked below.</p><ul>{items.filter(e => !e.spoiler).map(e => <li><a href={entryHref(e)}>{e.name}</a></li>)}</ul></noscript>
</div>
<style>
  .browse-tier-help{display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin:16px 0 6px;padding:14px 16px;border:1px solid #2b4147;background:#101e25}
  .browse-tier-legend{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .browse-power-legend{display:flex;gap:12px;flex-wrap:wrap;font:10px var(--mono);color:#acc1ca}.browse-power-legend span{display:inline-flex;align-items:center;gap:6px}.browse-power-legend .power-badge{width:22px;height:22px;font-size:11px}
  .browse-tier-help p{font-size:12px;line-height:1.6;color:#acc1ca;margin:0;flex:1;min-width:220px}
</style>
<script>import '../scripts/browser';</script>
