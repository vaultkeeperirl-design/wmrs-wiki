---
import Art from './Art.astro';
import {entries,entryHref,href} from '../lib/data';
import {guideCaptures,uiIcon,menuFacts,currencyFacts,combatFacts,chassisFacts,workshopFacts,equipmentSlots,rarities,tierFacts} from '../content/guide-visuals';
import '../styles/guide-visuals.css';
interface Props {guide:string;section:number;}
const {guide,section}=Astro.props;
const at=(name:string,index:number)=>guide===name&&section===index;
const captures=guideCaptures.filter(c=>c.guide===guide&&c.section===section);
const starterNames=['Ares [P]','Aegis [P]','Juggernaut [P]','Spectre [P]'];
const starters=starterNames.map(name=>entries.find(e=>e.category==='warmachines'&&e.name===name)).filter(Boolean);
const showCurrencies=at('economy',1)||at('start-here',4);
const showSlots=at('first-team',1)||at('equipment',1);
const showChassis=at('first-team',3)||at('advanced-strategy',2);
---
{at('start-here',1) && <section class="guide-visual learning-loop" aria-label="The WMRS preparation and reward loop"><p class="visual-kicker">THE DEPLOYMENT LOOP</p><ol>{[{icon:'hangar',title:'Prepare',copy:'Choose a frame, crew and gear.'},{icon:'patrol',title:'Deploy',copy:'Read the mission and fight through its floors.'},{icon:'nanites',title:'Collect',copy:'Review rewards, experience and losses.'},{icon:'workshop',title:'Improve',copy:'Upgrade, produce or recover before the next run.'}].map((step,index)=><li><span class="visual-step-number">0{index+1}</span><img src={href(uiIcon(step.icon))} alt="" width="64" height="64" loading="lazy" /><h3>{step.title}</h3><p>{step.copy}</p>{index<3&&<span class="loop-arrow" aria-hidden="true">→</span>}</li>)}</ol><p class="visual-caption">These are the game’s own menu and currency icons, used here as a guide to the decisions you make between runs.</p></section>}
{at('start-here',2) && <section class="guide-visual" aria-label="The four starter War Machines"><p class="visual-kicker">RECOGNIZE YOUR STARTER</p><div class="starter-visual-grid">{starters.map(e=>e&&<a class="starter-visual" href={entryHref(e)}><Art entry={e} /><div><h3>{e.family}</h3><span>{e.type} · P</span><p>{e.stats?.HP} HP · {e.stats?.Attack} ATK · {e.stats?.Defense} DEF</p></div></a>)}</div><p class="visual-caption">Official card artwork and fresh P-template values. Starter selection grants only the frame you choose.</p></section>}
{at('start-here',3) && <section class="guide-visual" aria-label="Main menu icon reference"><p class="visual-kicker">FIND IT IN THE MAIN MENU</p><div class="visual-icon-grid">{menuFacts.map(f=><a class="visual-icon-fact" href={href(f.path!)}><img src={href(uiIcon(f.icon))} alt="" width="68" height="68" loading="lazy" /><div><h3>{f.label}</h3><p>{f.description}</p></div></a>)}</div><p class="visual-caption">Look for these same icons in the game. Select an entry here for its guide.</p></section>}
{showCurrencies && <section class="guide-visual" aria-label="Currency icon reference"><p class="visual-kicker">KNOW WHAT YOU ARE SPENDING</p><div class="visual-icon-grid visual-three">{currencyFacts.map(f=><div class="visual-icon-fact"><img src={href(uiIcon(f.icon))} alt={`${f.label} game icon`} width="72" height="72" loading="lazy" /><div><h3>{f.label}</h3><p>{f.description}</p></div></div>)}</div><p class="visual-caption">Match the icon beside an in-game cost to the resource it consumes. A resource payment and a Nanite payment can be different alternatives.</p></section>}
{at('first-battle',2) && <section class="guide-visual" aria-label="Combat stat icons and shield-first example"><p class="visual-kicker">READ YOUR COMBAT STATS</p><div class="visual-icon-grid">{combatFacts.map(f=><div class="visual-icon-fact"><img src={href(uiIcon(f.icon))} alt="" width="60" height="60" loading="lazy" /><div><h3>{f.label}</h3><p>{f.description}</p></div></div>)}</div><div class="shield-example"><strong>30 damage</strong><span aria-hidden="true">→</span><div><img src={href(uiIcon('shield'))} alt="Shield" width="38" height="38" /><span>20 shield absorbed</span></div><span aria-hidden="true">→</span><div><img src={href(uiIcon('health'))} alt="Hull" width="38" height="38" /><span>10 hull lost</span></div></div><p class="visual-caption">Worked damage-splitting example: damage reaches hull only after the available shield is exhausted.</p></section>}
{at('first-battle',3) && <section class="guide-visual chance-example" aria-label="Accuracy and evasion example"><p class="visual-kicker">TWO CHECKS, NOT ONE</p><div><span><b>95%</b>base accuracy</span><strong>×</strong><span><b>90%</b>chance not to evade<br/><small>against 10% evasion</small></span><strong>=</strong><span class="example-result"><b>85.5%</b>normal hit chance</span></div><p class="visual-caption">Without suppression or special exceptions. Evasion is checked separately from accuracy.</p></section>}
{at('first-battle',4) && <section class="guide-visual damage-example" aria-label="Ordinary damage formula"><p class="visual-kicker">BEFORE THE RANDOM DAMAGE ROLL</p><div class="damage-equation"><span>Attack</span><strong>×</strong><span class="visual-fraction"><span>100</span><span>Defense + 100</span></span><strong>×</strong><span>active multipliers</span></div><p class="visual-caption">Then apply the 0.85–1.15 variance roll and rounding. Chassis advantage, crew specialty, critical hits and named effects can change the multiplier.</p></section>}
{showSlots && <section class="guide-visual loadout-visual" aria-label="Base-game loadout slots"><p class="visual-kicker">ONE FRAME, THE RIGHT SLOTS</p><div class="loadout-crew"><div><img src={href(uiIcon('warmachines'))} alt="War Machine" width="70" height="70" /><strong>War Machine</strong><small>provides the chassis</small></div><span aria-hidden="true">+</span><div><img src={href(uiIcon('pilot'))} alt="Pilot" width="70" height="70" /><strong>Primary pilot</strong><small>full crew stat contribution</small></div><span aria-hidden="true">+</span><div class="optional-crew"><img src={href(uiIcon('pilot'))} alt="" width="70" height="70" /><strong>Co-pilot</strong><small>only on dual-crew frames</small></div></div><div class="loadout-gear">{equipmentSlots.map(slot=><div><img src={href(uiIcon(slot.icon))} alt="" width="45" height="45" /><strong>{slot.label}</strong><small>{slot.description}</small></div>)}</div><p class="visual-caption">Six equipment slots: two weapons, armor, core, thrusters and shield. Stat symbols identify slot roles here; use each item’s actual equipment type to check compatibility.</p></section>}
{at('first-team',2) && <section class="guide-visual crew-contribution" aria-label="Primary pilot and co-pilot contribution"><p class="visual-kicker">CREW CONTRIBUTIONS ARE DIFFERENT</p><div class="visual-icon-grid visual-three"><div class="visual-value"><img src={href(uiIcon('pilot'))} alt="" width="64" height="64" /><b>100%</b><h3>Primary pilot stats</h3><p>Add the main pilot’s scaled stat bonuses.</p></div><div class="visual-value"><img src={href(uiIcon('pilot'))} alt="" width="64" height="64" /><b>45%</b><h3>Co-pilot stats</h3><p>Only when the frame has a second crew slot.</p></div><div class="visual-value"><img src={href(uiIcon('attack'))} alt="" width="64" height="64" /><b>50%</b><h3>Co-pilot weapon bonus</h3><p>Ranged/melee specialization is a separate calculation.</p></div></div></section>}
{showChassis && <section class="guide-visual chassis-visual" aria-label="Chassis damage advantage cycle"><p class="visual-kicker">FOLLOW THE CHASSIS ADVANTAGE CYCLE</p><ol>{chassisFacts.map(f=><li><img src={href(uiIcon(f.icon))} alt={`${f.name} chassis emblem`} width="90" height="90" loading="lazy" /><h3>{f.name}</h3><p>+30% damage<br/>against <b>{f.target}</b></p><span aria-hidden="true">→</span></li>)}</ol><p class="visual-caption">The cycle loops back from Guardian to Assault. Listed prototype advantages use their own stronger multiplier; inspect the specific card.</p></section>}
{at('upgrades',1) && <section class="guide-visual" aria-label="Card tier and rank are separate systems"><p class="visual-kicker">CARD TIER ≠ WORKSHOP RANK</p><div class="tier-visual">{tierFacts.map(f=><div><img src={href(uiIcon(f.icon))} alt={`${f.label} tier icon`} width="74" height="74" /><h3>{f.label}</h3><p>{f.description}</p></div>)}</div><p class="visual-caption">These are the actual Base, P, SP and HSP game symbols. They identify card variants, not star counts. Individual hidden reward identities remain behind the wiki’s spoiler controls.</p></section>}
{at('upgrades',2) && <section class="guide-visual rank-visual" aria-label="Workshop rank ladder"><p class="visual-kicker">THE STAR → GEAR LADDER</p><div><article><span class="rank-pips">★</span><h3>Rank 0</h3><b>1.00×</b><p>Fresh card</p></article><span aria-hidden="true">→</span><article><span class="rank-pips">★★★★★</span><h3>Rank 4</h3><b>1.28×</b><p>Four steps of +7%</p></article><span aria-hidden="true">→</span><article><span class="rank-pips">⚙⚙⚙⚙⚙</span><h3>Rank 9</h3><b>1.98×</b><p>Five more steps of +14%</p></article></div><p class="visual-caption">Multiplier for rank-scaled stat contributions. Early steps use one duplicate; later gear-phase steps use two. Resource payments are available only during the early star phase.</p></section>}
{at('upgrades',3) && <section class="guide-visual" aria-label="Workshop tab reference"><p class="visual-kicker">CHOOSE THE RIGHT WORKSHOP TAB</p><div class="visual-icon-grid">{workshopFacts.map(f=><div class="visual-icon-fact"><img src={href(uiIcon(f.icon))} alt={`${f.label} tab icon`} width="62" height="62" loading="lazy" /><div><h3>{f.label}</h3><p>{f.description}</p></div></div>)}</div></section>}
{at('upgrades',4) && <section class="guide-visual recovery-visual" aria-label="Recovery cost, success and retry time"><p class="visual-kicker">ORDINARY RECOVERY ATTEMPT</p><div class="visual-three"><div class="visual-value"><img src={href(uiIcon('nanites'))} alt="Nanites" width="62" height="62" /><b>500</b><h3>Nanites per attempt</h3></div><div class="visual-value"><img src={href(uiIcon('recovery'))} alt="Recovery" width="62" height="62" /><b>75%</b><h3>Success probability</h3></div><div class="visual-value"><img src={href(uiIcon('workshop'))} alt="Workshop" width="62" height="62" /><b>60 min</b><h3>Failed-attempt retry</h3></div></div><p class="visual-caption">Veteran Recovery Crew shortens the failed-attempt cooldown to 45 minutes. It does not improve the 75% success chance.</p></section>}
{(at('packs',1)||at('faq',1)) && <section class="guide-visual reward-visual" aria-label="Random rewards versus guaranteed rewards"><p class="visual-kicker">READ THE REWARD RULE FIRST</p><div><article><img src={href(uiIcon('scout'))} alt="Scout menu icon" width="76" height="76" /><span class="visual-rule">ONE RANDOM CARD</span><h3>Scout banner</h3><p>150 Nanites per pull. The listed rewards are possible outcomes, subject to eligibility.</p><a href={href('packs/')}>See eligible pools →</a></article><article><img src={href(uiIcon('shop'))} alt="Shop menu icon" width="76" height="76" /><span class="visual-rule">GUARANTEED LISTED REWARDS</span><h3>Shop bundle</h3><p>The offer grants its listed cards or currency. Check the current Steam checkout price.</p><a href={href('tools/pack-explorer/')}>Compare offers →</a></article></div></section>}
{at('packs',2) && <section class="guide-visual rarity-visual" aria-label="Scout rarity rates before pity"><p class="visual-kicker">RARITY RATES BEFORE PITY</p><div class="rarity-meter" aria-hidden="true">{rarities.map(r=><span style={`--rarity-color:${r.color};flex:${r.chance}`}></span>)}</div><div class="rarity-legend">{rarities.map(r=><div style={`--rarity-color:${r.color}`}><span></span><strong>{r.name}</strong><b>{r.chance}%</b></div>)}</div><p class="visual-caption">These are rarity probabilities, not individual-card odds. Your pity counter, owned cards and banner preference affect the actual selection.</p></section>}
{at('modes',1) && <section class="guide-visual" aria-label="Choose a combat mode"><p class="visual-kicker">DIFFERENT GOALS, SHARED ATTACK RULES</p><div class="visual-icon-grid visual-three">{[{icon:'patrol',label:'Patrol',description:'Repeatable missions and displayed clear rewards.'},{icon:'story',label:'Story',description:'Campaign chapters, scenarios and progression.'},{icon:'pits',label:'Fighting Pits',description:'Wave combat in Solo, Double and Triple formats.'}].map(f=><div class="visual-icon-fact"><img src={href(uiIcon(f.icon))} alt="" width="74" height="74" /><div><h3>{f.label}</h3><p>{f.description}</p></div></div>)}</div></section>}
{at('modes',2) && <section class="guide-visual visual-sorties" aria-label="Sortie access and chance limits"><img src={href(uiIcon('sorties'))} alt="Sorties game icon" width="90" height="90" /><div><p class="visual-kicker">SORTIES UNLOCK AT PLAYER LEVEL 10</p><h3>Check duration, committed cards and rewards.</h3><p>Finish the tutorial first. Completion probability is clamped to 5–98%; a high displayed chance still allows failure.</p></div></section>}
{captures.map(c=><figure class="guide-visual game-screen-figure"><p class="visual-kicker">{c.title}</p><div class="game-screen-frame"><img class="game-screen-image" src={href(c.image)} alt={c.alt} loading="lazy" decoding="async" />{c.callouts?.map(point=><span class="screen-callout" style={`left:${point.x}%;top:${point.y}%`} aria-hidden="true">{point.number}</span>)}</div><figcaption>{c.caption}</figcaption>{c.callouts&&<ol class="screen-callout-legend">{c.callouts.map(point=><li><span>{point.number}</span><div><h3>{point.label}</h3><p>{point.description}</p></div></li>)}</ol>}{c.details&&<div class="screen-crop-grid">{c.details.map(detail=><figure><img src={href(detail.image)} alt={detail.alt} loading="lazy" decoding="async" /><figcaption><strong>{detail.label}</strong>{detail.description}</figcaption></figure>)}</div>}</figure>)}
