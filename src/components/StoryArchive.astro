---
import {findStoryCampaign,missionHref} from '../lib/lore';
import '../styles/lore.css';
interface Props {campaignId?:string;chapterNumber?:number;}
const {campaignId,chapterNumber}=Astro.props;
const campaign=campaignId?findStoryCampaign(campaignId):undefined;
const chapter=campaign?.chapters.find(ch=>ch.chapter===chapterNumber);
const gateLabel=(floor:number,total:number)=>floor===0?'Mission start':floor<0?'Ending marker':floor>total?`Authored floor ${floor} marker`:`After floor ${floor}`;
---
{campaign&&<section class="story-archive"><details class="spoiler-box"><summary>{chapter?'Reveal complete chapter story & dialogue':'Reveal campaign story overview'}</summary><div class="story-archive-content">{chapter?<><p class="archive-kicker">CHAPTER {chapter.chapter} / STORY & CONVERSATIONS</p><h2>{chapter.title}</h2><p>{chapter.description}</p><p class="archive-note">The transcript preserves the original speaker names and text. “PILOT” refers to the player character. Mission dialogue and squad-channel comms are separate story layers.</p>{(['dialogue','comms'] as const).map(kind=><details class="archive-channel" open={kind==='dialogue'}><summary>{kind==='dialogue'?'Mission dialogue':'Squad comms'} · {chapter[kind].reduce((n,b)=>n+b.lines.length,0)} lines</summary>{chapter[kind].length?chapter[kind].map((beat,index)=><section class="archive-beat"><h3>{gateLabel(beat.afterFloor,chapter.floorCount)} <span>· beat {index+1}</span></h3>{beat.afterFloor>chapter.floorCount&&<p class="archive-note">This conversation uses an older floor number than the current mission length. It is included here for story reference; its original timing may differ from your playthrough.</p>}<dl>{beat.lines.map(line=><div><dt>{line.speaker}</dt><dd>{line.text}</dd></div>)}</dl></section>):<p class="archive-note">No {kind==='dialogue'?'mission dialogue':'squad comms'} beats are defined for this chapter.</p>}</details>)}</>:<><p class="archive-kicker">CAMPAIGN STORY</p><h2>{campaign.name}</h2><p>{campaign.description}</p><ol class="archive-chapter-list">{campaign.chapters.map(ch=><li>{missionHref(campaign,ch.chapter)?<a href={missionHref(campaign,ch.chapter)}>Chapter {ch.chapter}: {ch.title.replace(/^Chapter \d+:\s*/,'')}</a>:<strong>Chapter {ch.chapter}: {ch.title}</strong>}<p>{ch.description}</p></li>)}</ol></>}<details class="archive-sources"><summary>Story archive sources</summary><ul>{campaign.evidence.map(source=><li><code>{source}</code></li>)}</ul><p class="archive-note">Original story and squad conversations from the released base game.</p></details></div></details></section>}
