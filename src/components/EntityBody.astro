---
import Art from './Art.astro';
import Browser from './Browser.astro';
import {related, entries, entryHref, href, rarityColor, database, byId, type Entry} from '../lib/data';
interface Props {entry: Entry;}
const {entry: e} = Astro.props;
const isCard = ['warmachines','pilots','items'].includes(e.category);
const variants = isCard ? entries.filter(v => v.category === e.category && v.family === e.family && v.id !== e.id) : [];
const abilities = related(e.abilityIds);
const packs = related(e.packIds);
const rewards = related(e.rewardIds);
const links = related(e.relatedIds);
const safeLinks = links.filter(l => !l.spoiler);
const missionList = related(e.missionIds);
const weakness = Object.entries(database.rules.chassisCounters).find(([,target]) => target === e.type)?.[0];
const advantage = database.rules.chassisCounters[e.type ?? ''];
---
<div class="detail-grid">
<aside class="detail-art"><Art entry={e} eager /><small>{e.artworkNote ?? 'Official game artwork. Card statistics below use the fresh template, before levels, upgrades and equipment.'}</small>{isCard && <button class="collect-button" type="button" data-collect={e.id} aria-pressed="false">＋ Add to collection</button>}</aside>
<div class="detail-copy"><div class="flex flex-wrap gap-2"><span class="badge" style={`color:${rarityColor(e.rarity)}`}>{e.rarity ?? e.type}</span>{e.tier && <span class="badge">{e.tier}</span>}{e.faction && <span class="badge">{e.faction}</span>}</div><h2 class="entity-name display">{e.name}</h2><p>{e.description}</p>{e.note && <div class="notice">{e.note}</div>}
{e.stats && Object.keys(e.stats).length > 0 && <section class="panel"><h2>{['enemies','bosses'].includes(e.category) ? 'Enemy template statistics' : isCard ? 'Base template statistics' : 'Ability values'}</h2><div class="stat-grid">{Object.entries(e.stats).map(([key,value]) => <div class="stat-cell"><span>{key}</span><strong>{value}{/bonus|Evasion/.test(key) ? '%' : ''}</strong><div class="stat-bar"><span style={`width:${Math.min(100,Math.max(0,value) / (key === 'HP' ? 4 : key === 'Shield' ? 3 : 0.7))}%`}></span></div></div>)}</div><p class="tool-note">Stats are extracted from the game. Descriptions are developer-provided. Your owned card’s levels, rank, rolls and loadout can change its combat values.</p></section>}
{e.category === 'warmachines' && <section class="panel"><h2>Chassis & compatibility</h2><ul class="source-list"><li>Class: {e.type}. Pilot slots: {e.pilotSlots ?? 1}.</li><li>Equipment: two weapons, armor, core, thrusters and shield. All base-game pilots may crew this frame; duplicate/unique-family rules still apply.</li>{advantage && <li>Standard advantage: +30% damage against {advantage}. Vulnerable to {weakness}.</li>}{!!e.prototypeAdvantages?.length && <li>Prototype advantage: 1.5× against {e.prototypeAdvantages.join(', ')}.</li>}</ul><a class="text-link" href={href(`tools/team-builder/?frame=${e.id}`)}>Plan a loadout →</a></section>}
{e.category === 'pilots' && <section class="panel"><h2>Crew compatibility</h2><p class="tool-note">Can crew any base-game War Machine. A co-pilot slot requires a dual-crew frame. The main pilot supplies full stats; co-pilot stat contribution is 45%, while weapon-specialty contribution is 50%.</p><a class="text-link" href={href('guides/first-team/')}>Understand pilot synergy →</a></section>}
{e.category === 'items' && <section class="panel"><h2>Equipment compatibility</h2><p class="tool-note">Fits {e.type === 'Weapon' ? 'Weapon I or Weapon II' : `the ${e.type?.toLowerCase()} slot`} on a base-game frame. {e.chassisClass ? `Class-set tag: ${e.chassisClass}. It contributes to a set bonus when equipped to that chassis class.` : 'This template has no chassis-class set tag.'} One physical copy can occupy one slot at a time.</p><a class="text-link" href={href('guides/equipment/')}>Equipment rules →</a></section>}
{abilities.length > 0 && <section class="panel"><h2>Abilities & special effects</h2>{abilities.filter(a => !a.spoiler || e.spoiler).map(a => <div class="ability-row"><h3><a class="text-link" href={entryHref(a)}>{a.name}</a> <small>{a.type}</small></h3><p class="tool-note">{a.description}</p></div>)}</section>}
<section class="panel"><h2>{e.category === 'packs' ? 'Cost & availability' : 'Acquisition & requirements'}</h2><ul class="source-list">{e.sources.map(s => <li>{s}</li>)}</ul>{e.cost && <p class="eyebrow">{e.cost}</p>}{e.category === 'packs' && <span class="badge">{e.guaranteed ? 'GUARANTEED LISTED REWARDS' : 'ONE RANDOM ELIGIBLE REWARD / PULL'}</span>}</section>
{e.dossierRate !== undefined && <section class="panel"><h2>Enemy dossier</h2><p class="tool-note">{(e.dossierRate * 100).toFixed(0)}% dossier chance per eligible defeat. A recovered dossier unlocks production of the base frame. The game avoids granting a dossier you already own.</p></section>}
{e.rarityRates && <section class="panel"><h2>Verified rarity rates · before pity</h2><div class="stat-grid">{Object.entries(e.rarityRates).map(([r,p]) => <div class="stat-cell"><span>{r}</span><strong>{Math.round(p*100)}%</strong></div>)}</div><p class="tool-note">{e.probabilityNote}</p>{!!e.favoredFactions?.length && <p class="tool-note">Favored faction: <b>{e.favoredFactions.join(', ')}</b>. Other factions remain eligible.</p>}<a class="text-link" href={href('guides/packs/')}>Pity, duplicates and selection rules →</a></section>}
{e.currencyRewards && <section class="panel"><h2>Guaranteed currency</h2>{e.currencyRewards.map(r => <p>{r.amount.toLocaleString()} {r.name}</p>)}</section>}
{e.prices && <section class="panel"><h2>Rank prices</h2><div class="table-scroll"><table><thead><tr><th>Rank</th><th>Nanites</th><th>Direct USD catalog label</th></tr></thead><tbody>{e.prices.map((p,index) => <tr><td>{index+1}</td><td>{p.toLocaleString()}</td><td>{e.directPriceLabels?.[index] ?? 'Not listed'}</td></tr>)}</tbody></table></div></section>}
{e.category === 'missions' && <section class="panel"><h2>Deployment briefing</h2><p class="tool-note">Chapter {e.chapterNumber}. Clear {e.floorCount} floors. {e.recommendedRating ? `Recommended combat rating: ${e.recommendedRating}.` : ''} Regular enemy encounters are generated for the mission theme; the exact rolled roster is not fixed.</p>{e.campaignId && byId.get(e.campaignId) && <a class="text-link" href={entryHref(byId.get(e.campaignId)!)}>Back to campaign →</a>}<details class="spoiler-box"><summary>Reveal story, bosses & rewards</summary><h3>{e.spoilerTitle}</h3>{e.storyOverview && <p>{e.storyOverview}</p>}{e.encounters && <p class="tool-note">Encounter theme: {e.encounters}.</p>}{!!e.bosses?.length && <><h3>Authored boss placements</h3><ul class="source-list">{e.bosses.map(b => <li>{b.frameId && byId.has(b.frameId) ? <a class="text-link" href={entryHref(byId.get(b.frameId)!)}>{b.name}</a> : b.name ?? 'Generated boss'}{b.pilot && ` · ${b.pilot}`}{b.floor ? ` · floor ${b.floor}` : ''}</li>)}</ul></>}{rewards.map(r => <p><a class="text-link" href={entryHref(r)}>Reward: {r.name}</a></p>)}</details></section>}
{!!missionList.length && <section class="panel"><h2>Campaign missions</h2><ol class="source-list">{missionList.map(m => <li><a class="text-link" href={entryHref(m)}>Chapter {m.chapterNumber}</a> · {m.floorCount} floors</li>)}</ol><a class="text-link" href={href('guides/campaign-progression/')}>Campaign unlocks and preparation →</a></section>}
{e.upgrades && <details class="panel"><summary>Workshop rank costs · all nine upgrades</summary><p class="tool-note">Each step lists alternative duplicate, Nanite and early resource paths. This table does not imply a production blueprint is unlocked.</p><div class="table-scroll"><table><thead><tr><th>To rank</th><th>Stat multiplier</th><th>Duplicate copies</th><th>Nanites</th><th>Alloy / Data alternative</th></tr></thead><tbody>{e.upgrades.map(u => <tr><td>{u.rank}</td><td>{u.multiplier.toFixed(2)}×</td><td>{u.duplicates}</td><td>{u.nanites.toLocaleString()}</td><td>{u.resources ? `${u.resources.alloy} / ${u.resources.dataFragments}` : 'Unavailable at this step'}</td></tr>)}</tbody></table></div><a class="text-link" href={href('guides/upgrades/')}>How upgrading works →</a></details>}
{packs.length > 0 && <section class="panel"><h2>Found in these packs</h2><ul class="source-list">{packs.map(p => <li><a class="text-link" href={entryHref(p)}>{p.name}</a> · {p.guaranteed ? 'Guaranteed' : 'Eligible random reward'}</li>)}</ul></section>}
{safeLinks.length > 0 && <section class="panel"><h2>Verified signature pairing</h2><p class="tool-note">This pairing grants +8% HP, Attack and Defense. It is a game-defined pairing rather than a general faction match.</p><ul class="source-list">{safeLinks.map(l => <li><a class="text-link" href={entryHref(l)}>{l.name}</a></li>)}</ul></section>}
{variants.length > 0 && <section class="panel"><h2>Card variants</h2><div class="button-row">{variants.filter(v => !v.spoiler).map(v => <a class="button secondary" href={entryHref(v)}>{v.tier}</a>)}</div>{variants.some(v => v.spoiler) && <details class="spoiler-box"><summary>Reveal hidden variants</summary><ul class="source-list">{variants.filter(v => v.spoiler).map(v => <li><a class="text-link" href={entryHref(v)}>{v.name}</a></li>)}</ul></details>}</section>}
<details class="panel"><summary>Source & verification notes</summary><p class="tool-note">Extracted from game version {database.gameVersion}. Fresh template statistics and catalog relationships are source-verified. Strategies in guides are reasoned from the implemented rules, unless explicitly described as tested.</p><ul class="source-list">{e.evidence.map(source => <li><code>{source}</code></li>)}</ul></details>
</div></div>
{e.category === 'packs' && rewards.length > 0 && <section class="mt-10"><div class="section-top"><h2>{e.guaranteed ? 'Every guaranteed card' : 'Every possible card'}</h2><span class="eyebrow">{rewards.length} REWARDS</span></div><Browser items={rewards} /></section>}
