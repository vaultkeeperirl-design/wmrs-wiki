---
import Layout from '../../layouts/Layout.astro';
import Browser from '../../components/Browser.astro';
import {entries,href,entryHref} from '../../lib/data';
import {glossary} from '../../content/guides';
const tools:Record<string,{title:string;description:string}>={compare:{title:'Compare cards',description:'Compare up to three War Machines, pilots, equipment cards or packs. Fresh template values keep the comparison consistent.'},'pack-explorer':{title:'Pack Explorer',description:'Search every offer by reward category and rarity, then compare possible and guaranteed rewards side by side.'},'team-builder':{title:'Team Builder',description:'Plan a base-game six-bay squad with verified slot types, crew rules and fresh loadout statistics.'},collection:{title:'My collection',description:'Track your cards and achievements in this browser. Nothing here reads or changes your game save.'},progression:{title:'Your progression route',description:'A source-verified path through the base game, from onboarding to late-game mastery.'},glossary:{title:'WMRS glossary',description:'Clear definitions for the terms you encounter in the Hangar, Workshop and battlefield.'}};
export function getStaticPaths(){return ['compare','pack-explorer','team-builder','collection','progression','glossary'].map(tool=>({params:{tool}}));}
const tool=Astro.params.tool!;const meta=tools[tool];
const campaigns=entries.filter(e=>e.category==='campaigns');
---
<Layout title={meta.title} description={meta.description}><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={href()}>Command center</a><span>/</span>Player tools<span>/</span>{meta.title}</nav><div class="page-heading"><p class="eyebrow">PLAYER TOOLS / NO ACCOUNT REQUIRED</p><h1>{meta.title}</h1><p>{meta.description}</p></div>
{(tool==='compare'||tool==='pack-explorer') && <section id="compare-tool" data-pack-only={tool==='pack-explorer'?'true':'false'}><div class="filters"><div class="field"><label for="compare-category">COMPARE CATEGORY</label><select id="compare-category"><option value="warmachines">War Machines</option><option value="pilots">Pilots</option><option value="items">Equipment</option><option value="packs">Packs</option></select></div><div class="field wide"><label for="compare-query">FILTER CHOICES</label><input id="compare-query" type="search" placeholder="Filter by name, faction or type…" /></div><label class="tool-note"><input type="checkbox" id="compare-spoilers" /> Reveal spoilers</label></div><div class="comparison-controls">{[0,1,2].map(i=><div class="field"><label for={`compare-${i}`}>CARD {i+1}</label><select id={`compare-${i}`}><option>Loading catalog…</option></select></div>)}</div><div id="comparison-output" class="table-scroll" aria-live="polite"></div><p class="tool-note">A highlighted value is the highest number among the compared templates; higher is not automatically better for every role. Negative gear tradeoffs remain visible.</p></section>}
{tool==='pack-explorer' && <section class="mt-10"><div class="section-top"><h2>Browse by rewards</h2><a href={href('guides/packs/')}>HOW PACKS WORK →</a></div><Browser items={entries.filter(e=>e.category==='packs')} category="packs" rewardFilter /></section>}
{tool==='team-builder' && <section id="team-tool"><div class="notice safe-note">Planner assumptions: level 1, Workshop rank 0, no rolled modifiers or temporary effects. Repeated templates represent separate physical copies you must own. Live format, inventory and activity locks remain in the game.</div><div class="filters"><label class="tool-note"><input id="team-spoilers" type="checkbox" /> Reveal hidden cards</label><div class="field wide"><label for="team-query">FILTER CARD CHOICES</label><input id="team-query" type="search" placeholder="Name, faction or type…" /></div><button class="button secondary" id="team-clear" type="button">Clear plan</button></div><div id="team-tabs" class="team-tabs" aria-label="Choose squad bay"></div><div class="split-panels"><div class="panel"><h2 id="team-bay-title">Bay 1 loadout</h2><div id="team-fields"></div></div><div class="panel"><h2>Fresh loadout statistics</h2><div id="team-stats" class="stat-grid"></div><h3 class="mt-6">Deployment checks</h3><div id="team-errors" role="status" class="tool-note"></div><p class="tool-note">Main crew contributes 100%; eligible co-pilot contributes 45% to these stats. Verified signature pairs and matching gear sets are included.</p><a class="text-link" href={href('guides/first-team/')}>Learn team building →</a></div></div></section>}
{tool==='collection' && <><div class="filters"><button type="button" class="button secondary" id="collection-export">Export checklist</button><label class="button secondary" for="collection-import">Import checklist</label><input class="sr-only" type="file" accept="application/json,.json" id="collection-import" /><span class="tool-note">JSON backup · cards, achievements and learning progress.</span></div><div id="collection-summary" class="notice safe-note" role="status">Your checklist is stored on this device.</div><Browser items={entries.filter(e=>['warmachines','pilots','items','achievements'].includes(e.category))} collection /></>}
{tool==='progression' && <div class="progress-list"><article class="progress-item"><strong>01</strong><div><h2>Onboarding → first squad</h2><p class="tool-note">Choose a starter frame, finish the tutorial, fit your pilot and equipment, and clear a manageable Patrol.</p><a class="text-link" href={href('guides/start-here/')}>Start the journey →</a></div></article><article class="progress-item"><strong>02</strong><div><h2>Follow the base campaign order</h2><p class="tool-note">Mecha Hearts → Aegis Initiative → Zenith War → Crimson Vanguard → Kuro’s campaign. Chapters require the preceding chapter; completing a base campaign unlocks the next.</p><div class="button-row">{campaigns.map(c=><a class="button secondary" href={entryHref(c)}>{c.name}</a>)}</div></div></article><article class="progress-item"><strong>03</strong><div><h2>Player Level 10 → Sorties</h2><p class="tool-note">Sorties become available once the tutorial is finished and Player Level 10 is reached. Assign available cards to timed missions and inspect the board’s completion factors and rewards.</p><a class="text-link" href={href('guides/modes/')}>Sortie rules →</a></div></article><article class="progress-item"><strong>04</strong><div><h2>Blueprints → upgrades → mastery</h2><p class="tool-note">Common recipes start available. Discover an SP to unlock ordinary family production, or recover an enemy dossier for its base blueprint. Early ranks offer farmable resource payments. Later mastery projects evolve individual SP cards.</p><a class="text-link" href={href('guides/upgrades/')}>Workshop progression →</a></div></article><article class="progress-item"><strong>05</strong><div><h2>Ranked goals and collection milestones</h2><p class="tool-note">Ranked divisions run from Bronze to Rogue. Achievement tracking is local to this browser; live ranks and rewards are managed in-game.</p><a class="text-link" href={href('achievements/')}>Browse achievements →</a></div></article></div>}
{tool==='glossary' && <div class="glossary-list">{glossary.map(([term,definition])=><article><h2>{term}</h2><p>{definition}</p></article>)}</div>}
<noscript><div class="notice">Enable JavaScript for interactive comparison, team planning and checklist features.</div></noscript>
<script>import '../../scripts/tools';</script>
</Layout>
