---
import Layout from '../../layouts/Layout.astro';
import Browser from '../../components/Browser.astro';
import {categories, entries, href, byId, entryHref} from '../../lib/data';
import {sortedBrowseGroups} from '../../lib/browse';
import '../../styles/campaign-directory.css';
export function getStaticPaths(){return Object.keys(categories).map(category => ({params:{category}}));}
const category = Astro.params.category!;
const meta = categories[category];
const items = entries.filter(e => e.category === category);
const orderedCampaigns = category==='campaigns'?sortedBrowseGroups(items,'campaign-order',false,byId).map(group=>group[0]):[];
---
<Layout title={`WMRS ${meta.label}`} description={`${meta.description} Browse the Warmachine Rogue Scout wiki.`}>
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href={href()}>Command center</a><span>/</span><span>{meta.label}</span></nav>
<div class="page-heading"><p class="eyebrow">WMRS / GAME DATABASE</p><h1>{meta.label}</h1><p>{meta.description}</p></div>
{category === 'packs' && <div class="notice safe-note">Scout banners list possible rewards. Shop bundles list guaranteed rewards. USD catalog prices may differ from your current Steam checkout. <a class="text-link" href={href('tools/pack-explorer/')}>Compare packs →</a></div>}
{['warmachines','pilots','items'].includes(category) && <div class="button-row mb-6"><a class="button secondary" href={href(`tools/compare/?category=${category}`)}>Compare {meta.label.toLowerCase()} ⇄</a><a class="button secondary" href={href('tools/collection/')}>My collection ◇</a></div>}
{category==='campaigns'?<section class="campaign-route" aria-label="Campaigns in story order">
  <div class="campaign-route-intro"><div><h2>Play the base story in this order</h2><p>Complete each campaign to unlock the next. Open a campaign to see its chapters, prerequisites and click-to-reveal story details.</p></div><a href={href('guides/campaign-progression/')}>How campaign progression works →</a></div>
  <div class="campaign-search"><label for="campaign-search">FIND A CAMPAIGN</label><input type="search" id="campaign-search" placeholder="Search campaign names…" autocomplete="off" /><p id="campaign-result-count" role="status" aria-live="polite">{orderedCampaigns.length} campaigns in story order</p></div>
  <ol class="campaign-directory">{orderedCampaigns.map((campaign,index)=><li data-campaign-name={campaign.name.toLocaleLowerCase()}><article class="campaign-route-card">
    <div class="campaign-route-number" aria-label={`Campaign ${index+1}`}>{String(index+1).padStart(2,'0')}</div>
    <a class="campaign-route-art" href={entryHref(campaign)} aria-label={`Open ${campaign.name}`}>{campaign.image?<img src={href(campaign.image)} width="520" height="300" alt={`${campaign.name} official campaign artwork`} loading="lazy" />:<span>STORY CAMPAIGN</span>}</a>
    <div class="campaign-route-copy"><span class="campaign-route-kicker">{index===0?'STARTING CAMPAIGN':`CAMPAIGN ${index+1} OF ${orderedCampaigns.length}`}</span><h2><a href={entryHref(campaign)}>{campaign.name}</a></h2><p class="campaign-route-requirement"><strong>Prerequisite:</strong> {index===0?'Begin the base story in Story Mode.':`Complete ${orderedCampaigns[index-1].name}.`}</p><p class="campaign-route-chapters">{campaign.missionIds?.length??0} chapters · ordered mission directory</p><a class="campaign-route-open" href={entryHref(campaign)}>View chapters <span aria-hidden="true">→</span></a></div>
  </article></li>)}</ol>
  <p id="campaign-no-results" class="empty-state" hidden>No campaign matches that name. Clear your search to see the full story route.</p>
  <p class="campaign-route-footnote">The numbers above show story order. Chapter numbering is local to each campaign; mission pages use numeric chapter order.</p>
</section>:<Browser items={items} category={category} rewardFilter={category === 'packs'} />}
<script>
  const campaignSearch=document.querySelector<HTMLInputElement>('#campaign-search');
  campaignSearch?.addEventListener('input',()=>{
    const term=campaignSearch.value.trim().toLocaleLowerCase();
    const rows=[...document.querySelectorAll<HTMLElement>('[data-campaign-name]')];
    let visible=0;
    rows.forEach(row=>{const match=row.dataset.campaignName!.includes(term);row.hidden=!match;if(match)visible++;});
    const count=document.querySelector('#campaign-result-count');if(count)count.textContent=term?`${visible} of ${rows.length} campaigns · story order preserved`:`${rows.length} campaigns in story order`;
    const empty=document.querySelector<HTMLElement>('#campaign-no-results');if(empty)empty.hidden=visible>0;
  });
</script>
</Layout>
