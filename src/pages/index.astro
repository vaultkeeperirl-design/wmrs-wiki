---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import {categories, entries, href, database} from '../lib/data';
import {journey} from '../content/guides';
const count = (category: string) => ['warmachines','pilots','items'].includes(category) ? new Set(entries.filter(e=>e.category===category).map(e=>e.family)).size : entries.filter(e => e.category === category).length;
const tiles = ['warmachines','pilots','items','packs'].map(key => ({key, image: entries.find(e => e.category === key && !e.spoiler && e.image && (key !== 'packs' || e.type === 'Scout banner'))?.image}));
const featured = ['Ares [P]','Aegis [P]','Juggernaut [P]','Spectre [P]'].map(name => entries.find(e => e.category === 'warmachines' && e.name === name)).filter(Boolean);
---
<Layout title="Official field guide & game database">
<section class="hero"><img class="hero-image" src={href('assets/title/base/ares-full-title.webp')} alt="Official Ares War Machine artwork" fetchpriority="high" width="1280" height="1280" /><div class="hero-content"><p class="eyebrow"><span class="status-dot"></span> WARMACHINE: ROGUE SCOUT / FIELD MANUAL</p><h1>Know your machine.<br/><em>Own the battlefield.</em></h1><p>Your companion to the war. Explore every frame, build your squad, and learn the systems that turn a rookie scout into a commander.</p><div class="button-row"><a class="button" href={href('guides/start-here/')}>New to WMRS? Start here <span>↗</span></a><a class="button secondary" href={href('warmachines/')}>Browse the database →</a></div></div><span class="hero-id">CHASSIS INTELLIGENCE // ARES<br/>BASE GAME · {database.gameVersion}</span></section>
<div class="stats-strip">{[['warmachines','WAR MACHINE FAMILIES'],['pilots','PILOT FAMILIES'],['items','EQUIPMENT FAMILIES'],['packs','PACKS & OFFERS']].map(([key,label]) => <div><strong>{count(key).toLocaleString()}</strong><span>{label}</span></div>)}</div>
<section class="journey" aria-labelledby="journey-title"><div class="section-top"><h2 id="journey-title"><span class="section-index">01 /</span> New Player Journey</h2><span id="journey-count" class="eyebrow">0 / 6 COMPLETE</span></div><p>One clear route from your first deployment to advanced squad building. Pick up where you left off.</p><div class="journey-steps">{journey.map((step,index) => <div class="journey-step" data-step={step.slug}><span class="step-number">0{index+1} <span aria-hidden="true">↗</span></span><a href={href(`guides/${step.slug}/`)}>{step.label}</a><small>{step.hint}</small><button type="button" data-journey={step.slug} aria-pressed="false">○ Mark complete</button></div>)}</div><div class="journey-progress"><div id="journey-bar" style="width:0%"></div></div></section>
<section><div class="section-top"><h2><span class="section-index">02 /</span> Explore the arsenal</h2><a href={href('search/')}>ALL INTELLIGENCE →</a></div><div class="category-grid">{tiles.map(tile => <a href={href(`${tile.key}/`)} class="category-tile">{tile.image && <img src={href(tile.image)} alt="" loading="lazy" width="400" height="400" />}<h3>{categories[tile.key].label}</h3><span>{count(tile.key)} ENTRIES ↗</span></a>)}</div></section>
<section class="mb-10"><div class="section-top"><h2><span class="section-index">03 /</span> Choose your first frame</h2><a href={href('tools/compare/')}>COMPARE WAR MACHINES →</a></div><div class="gallery">{featured.map(e => e && <Card entry={e} />)}</div></section>
<div class="split-panels"><section class="panel"><p class="eyebrow">REWARD INTELLIGENCE</p><h2>What’s actually in that pack?</h2><p class="tool-note">See the complete eligible pool, guaranteed rewards and verified rarity odds before you spend. Every reward links back to its source.</p><a class="button secondary" href={href('tools/pack-explorer/')}>Open Pack Explorer →</a></section><section class="panel"><p class="eyebrow">SQUAD PLANNING</p><h2>Build it before you deploy.</h2><p class="tool-note">Compare cards, plan a six-bay loadout and track your collection. Your choices stay in your browser.</p><a class="button secondary" href={href('tools/team-builder/')}>Open Team Builder →</a></section></div>
</Layout>
