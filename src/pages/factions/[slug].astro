---
import Layout from '../../layouts/Layout.astro';
import Browser from '../../components/Browser.astro';
import {factions} from '../../lib/lore';
import {entries,entryHref,href} from '../../lib/data';
import '../../styles/lore.css';
export function getStaticPaths(){return factions.map(faction=>({params:{slug:faction.id},props:{faction}}));}
const {faction}=Astro.props;
const abilities=entries.filter(e=>e.category==='abilities'&&e.faction===faction.faction&&!e.spoiler);
const roster=entries.filter(e=>['warmachines','pilots','items'].includes(e.category)&&e.faction===faction.faction);
const packs=entries.filter(e=>e.category==='packs'&&e.favoredFactions?.includes(faction.faction));
---
<Layout title={`${faction.name} faction`} description={faction.description} image={faction.emblem}><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={href()}>Command center</a><span>/</span><a href={href('factions/')}>Factions</a><span>/</span>{faction.name}</nav><div class="faction-heading"><img src={href(faction.emblem)} alt={`${faction.name} official emblem`} width="128" height="128" /><div><p class="eyebrow">BASE-GAME FACTION RECORD</p><h1>{faction.name}</h1><p>{faction.description}</p></div></div><section class="panel"><h2>Combat identity</h2><p class="tool-note">The frame provides its faction’s Chassis Special and Defend effect. The assigned pilot provides its own faction passive; mixing factions is allowed.</p><div class="faction-ability-grid">{abilities.map(a=><article><span>{a.type}</span><h3><a class="text-link" href={entryHref(a)}>{a.name}</a></h3><p>{a.description}</p></article>)}</div><a class="text-link" href={href('guides/first-team/')}>Understand crew and faction synergy →</a></section><section class="panel"><h2>Scout preference</h2>{packs.length?<><p class="tool-note">These banners favor this faction when eligible. They still share the broader base-game Scout pool.</p><div class="button-row">{packs.map(p=><a class="button secondary" href={entryHref(p)}>{p.name}</a>)}</div></>:<p class="tool-note">No faction-specific preference banner is defined in the reviewed catalog.</p>}</section><section class="faction-lore-section"><details class="spoiler-box"><summary>Reveal all {faction.pages.length} faction lore pages · story & hidden reward spoilers</summary><div class="faction-lore-pages">{faction.pages.map(page=><article><p class="archive-kicker">LORE PAGE {page.page}</p><p>{page.text}</p></article>)}</div><p class="archive-note">The complete Red Book lore is reproduced in its original page order.</p></details></section><section class="mt-10"><div class="section-top"><h2>Faction cards & equipment</h2><a href={href('tools/compare/')}>COMPARE CARDS →</a></div><p class="tool-note">Variants are grouped by default. Hidden cards remain protected until you explicitly reveal them.</p><Browser items={roster} /></section></Layout>
